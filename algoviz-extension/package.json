{
  "name": "algoviz-vscode",
  "displayName": "AlgoViz",
  "description": "Algorithm Visualizer inside VS Code",
  "version": "0.1.0",
  "publisher": "somyajeet",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssgamingop/AlgoViz.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "algoviz.start",
        "title": "AlgoViz: Start Visualization"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build:webview": "vite build",
    "build:vsix": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3",
    "esbuild": "^0.18.11",
    "npm-run-all": "^4.1.5",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
