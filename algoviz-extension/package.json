{
  "name": "algoviz-vscode",
  "displayName": "AlgoViz \u2014 Code Visualizer for C++ & JavaScript",
  "description": "Step through C++ and JavaScript line by line and watch arrays, queues, linked lists, trees and graphs change. For students and teachers. Works offline.",
  "version": "2.3.0",
  "publisher": "somyacodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/somyacodes07/algoviz.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Debuggers"
  ],
  "license": "MIT",
  "readme": "README.md",
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "algoviz",
          "title": "AlgoViz",
          "icon": "media/algoviz.svg"
        }
      ]
    },
    "views": {
      "algoviz": [
        {
          "type": "webview",
          "id": "algoviz.visualizer",
          "name": "Visualizer",
          "icon": "media/algoviz.svg",
          "contextualTitle": "AlgoViz"
        }
      ]
    },
    "commands": [
      {
        "command": "algoviz.visualizeCurrentFile",
        "title": "Visualize Active File",
        "category": "AlgoViz",
        "icon": "$(play-circle)"
      },
      {
        "command": "algoviz.rerun",
        "title": "Re-run",
        "category": "AlgoViz",
        "icon": "$(refresh)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.stepBack",
        "title": "Step Back",
        "category": "AlgoViz",
        "icon": "$(debug-step-back)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.stepForward",
        "title": "Step Forward",
        "category": "AlgoViz",
        "icon": "$(debug-step-over)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.play",
        "title": "Play",
        "category": "AlgoViz",
        "icon": "$(debug-continue)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.pause",
        "title": "Pause",
        "category": "AlgoViz",
        "icon": "$(debug-pause)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.runToCursor",
        "title": "Run to Cursor",
        "category": "AlgoViz",
        "icon": "$(debug-step-into)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.stop",
        "title": "Stop Visualizing",
        "category": "AlgoViz",
        "icon": "$(debug-stop)",
        "enablement": "algoviz.sessionActive"
      },
      {
        "command": "algoviz.focus",
        "title": "Show Visualizer",
        "category": "AlgoViz"
      },
      {
        "command": "algoviz.openSettings",
        "title": "Settings",
        "category": "AlgoViz",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "algoviz.visualizeCurrentFile",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "algoviz.stepForward",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "algoviz.sessionActive && !inDebugMode"
      },
      {
        "command": "algoviz.stepBack",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "algoviz.sessionActive && !inDebugMode"
      },
      {
        "command": "algoviz.play",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "algoviz.sessionActive && !algoviz.playing"
      },
      {
        "command": "algoviz.pause",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "algoviz.sessionActive && algoviz.playing"
      },
      {
        "command": "algoviz.runToCursor",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "algoviz.sessionActive && editorTextFocus"
      },
      {
        "command": "algoviz.stop",
        "key": "shift+escape",
        "when": "algoviz.sessionActive && editorTextFocus && !inDebugMode"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "algoviz.visualizeCurrentFile",
          "group": "1_run",
          "when": "(editorLangId == cpp || editorLangId == c || editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact)"
        }
      ],
      "editor/title": [
        {
          "command": "algoviz.stepBack",
          "group": "navigation@1",
          "when": "algoviz.sessionActive && resourcePath in algoviz.boundPaths"
        },
        {
          "command": "algoviz.play",
          "group": "navigation@2",
          "when": "algoviz.sessionActive && !algoviz.playing && resourcePath in algoviz.boundPaths"
        },
        {
          "command": "algoviz.pause",
          "group": "navigation@2",
          "when": "algoviz.sessionActive && algoviz.playing && resourcePath in algoviz.boundPaths"
        },
        {
          "command": "algoviz.stepForward",
          "group": "navigation@3",
          "when": "algoviz.sessionActive && resourcePath in algoviz.boundPaths"
        },
        {
          "command": "algoviz.stop",
          "group": "navigation@4",
          "when": "algoviz.sessionActive && resourcePath in algoviz.boundPaths"
        }
      ],
      "editor/context": [
        {
          "command": "algoviz.visualizeCurrentFile",
          "group": "algoviz@1",
          "when": "(editorLangId == cpp || editorLangId == c || editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact)"
        },
        {
          "command": "algoviz.runToCursor",
          "group": "algoviz@2",
          "when": "algoviz.sessionActive && resourcePath in algoviz.boundPaths"
        }
      ],
      "view/title": [
        {
          "command": "algoviz.visualizeCurrentFile",
          "group": "navigation@1",
          "when": "view == algoviz.visualizer"
        },
        {
          "command": "algoviz.stop",
          "group": "navigation@2",
          "when": "view == algoviz.visualizer && algoviz.sessionActive"
        },
        {
          "command": "algoviz.openSettings",
          "group": "navigation@3",
          "when": "view == algoviz.visualizer"
        }
      ],
      "commandPalette": [
        {
          "command": "algoviz.runToCursor",
          "when": "algoviz.sessionActive && editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "AlgoViz",
      "properties": {
        "algoviz.cppCompiler": {
          "type": "string",
          "enum": [
            "wasm",
            "api"
          ],
          "enumDescriptions": [
            "Compile on this computer with Clang (WebAssembly). Works offline. Falls back to the remote compiler if it cannot start.",
            "Compile remotely with GCC on Compiler Explorer (needs internet; your code is sent there)."
          ],
          "default": "wasm",
          "description": "How C++ files are compiled before tracing."
        },
        "algoviz.rerunOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-run the visualization automatically when the file being visualized is saved."
        },
        "algoviz.inlineValues": {
          "type": "boolean",
          "default": true,
          "description": "Show the values that changed at the current step at the end of the highlighted line."
        },
        "algoviz.followExecution": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the editor to keep the executing line in view."
        },
        "algoviz.playbackSpeed": {
          "type": "number",
          "default": 600,
          "minimum": 50,
          "maximum": 3000,
          "description": "Milliseconds per step while playing."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build:webview": "vite build",
    "build:vsix": "npx @vscode/vsce package",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "npx ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.18.11",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.1.3",
    "vite": "^5.0.0"
  },
  "keywords": [
    "algorithm",
    "visualizer",
    "visualization",
    "data structures",
    "dsa",
    "c++",
    "cpp",
    "javascript",
    "education",
    "learning",
    "teaching",
    "students",
    "step through",
    "debugger",
    "linked list",
    "binary tree",
    "graph",
    "sorting",
    "recursion",
    "bfs"
  ],
  "homepage": "https://github.com/somyacodes07/algoviz#readme",
  "bugs": {
    "url": "https://github.com/somyacodes07/algoviz/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free"
}
