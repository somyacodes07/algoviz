{
  "name": "algoviz-vscode",
  "displayName": "AlgoViz",
  "description": "Algorithm Visualizer inside VS Code",
  "version": "1.1.0",
  "publisher": "somyacodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/somyacodes07/AlgoViz-copy.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Other"
  ],
  "license": "MIT",
  "readme": "README.md",
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "algoviz.start",
        "title": "AlgoViz: Open Visualizer Workbench",
        "icon": "$(play)"
      },
      {
        "command": "algoviz.visualizeCurrentFile",
        "title": "AlgoViz: Visualize Active File",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "algoviz.visualizeCurrentFile",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "algoviz.visualizeCurrentFile",
          "group": "1_run"
        }
      ],
      "editor/context": [
        {
          "command": "algoviz.visualizeCurrentFile",
          "group": "navigation",
          "when": "editorLangId == cpp || editorLangId == c || editorLangId == javascript || editorLangId == typescript"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build:webview": "vite build",
    "build:vsix": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.18.11",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.1.3",
    "vite": "^5.0.0"
  }
}